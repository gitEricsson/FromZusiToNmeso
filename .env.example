# Copy these into Netlify: Site configuration > Environment variables.
# Never commit real values.

# Brevo SMTP login (the email address on your Brevo account)
EMAIL_USER=you@example.com
# Brevo SMTP key: Brevo dashboard > SMTP & API > SMTP keys
EMAIL_PASS=your-brevo-smtp-key
# Who receives the gift details (defaults to omoeguare@gmail.com)
YOUR_EMAIL=omoeguare@gmail.com
